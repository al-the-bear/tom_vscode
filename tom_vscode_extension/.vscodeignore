# Source files (compiled to out/). `**/*.ts` also covers `*.d.ts`; we ship no
# `.d.ts` at runtime (the only own one is the dev-only media/types shim below),
# so there is intentionally no `!**/*.d.ts` re-include.
src/**
**/*.ts

# Build config
tsconfig.json
tsconfig.media.json
.vscode/**

# Development files
_copilot_guidelines/**
doc/**
!doc/quick_reference.md
!doc/workspace_setup.md
# tomAi_describeTool reads it at run time (src/tools/describe-tool.ts)
!doc/llm_tools.md
example/**
.npmrc

# Webview media dev-only types (the runtime media assets DO ship; the ambient
# typecheck shims under media/types/ are dev-only — exclude them even though the
# global !**/*.d.ts re-include rule above would otherwise pull them in).
media/types/**

# Test files
**/*.test.js

# The build stamps (validate_codespecs.build.json, spec_checks.build.json,
# scripts/codespecs-binary-stamp.cjs;
# tom_bs.build.json, scripts/binaries-layer.cjs): they describe the machine that
# built the binary, for the freshness checks.
bin/*/*.build.json

# The TomSpecs SOM tarballs (scripts/build-som-packages.cjs). They are installed
# into node_modules, which is what ships; the tarballs themselves are build input.
vendor/**

# The Agent SDK CLI tarballs --all-platforms fetches (install_extension.*); the
# binaries themselves ship as bin/<platform>/claude[.exe].
.cache/**

# The copy of the workspace template beside the VSIX (the one in resources/
# ships)
workspace_template.zip

# create_layerbinaries_vsix's clone of tom_binaries: build input, not shipped.
.tom_binaries/**
