{
  "name": "tom-ai-extension",
  "displayName": "@Tom",
  "description": "AI-powered workspace automation with Copilot, Local LLM, and AI Chat integration",
  "version": "0.1.0",
  "publisher": "peter-nicolai-alexis-kyaw",
  "repository": {
    "type": "git",
    "url": "https://github.com/al-the-bear/tom_vscode.git",
    "directory": "tom_vscode_extension"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:tomAi.markdownBrowser"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatVariables": [
      {
        "id": "tomAi.quest",
        "name": "quest",
        "description": "Current active quest ID"
      },
      {
        "id": "tomAi.role",
        "name": "role",
        "description": "Current AI role / persona"
      },
      {
        "id": "tomAi.activeProjects",
        "name": "activeProjects",
        "description": "Currently active project IDs"
      },
      {
        "id": "tomAi.todo",
        "name": "todo",
        "description": "Current todo summary from the active quest"
      },
      {
        "id": "tomAi.workspaceName",
        "name": "workspaceName",
        "description": "Current workspace name"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tomAi-sidebar",
          "title": "@TOM",
          "icon": "resources/tom-sidebar.svg"
        },
        {
          "id": "tomAi-ws-sidebar",
          "title": "@TOM WS",
          "icon": "resources/tom-ws-sidebar.svg"
        },
        {
          "id": "tomAi-vsc-sidebar",
          "title": "@TOM VSC",
          "icon": "resources/tom-vsc-sidebar.svg"
        },
        {
          "id": "tomAi-info-sidebar",
          "title": "@TOM INFO",
          "icon": "resources/tom-info-sidebar.svg"
        },
        {
          "id": "tomAi-todo-sidebar",
          "title": "@TOM TODO",
          "icon": "resources/tom-todo-sidebar.svg"
        }
      ],
      "panel": [
        {
          "id": "tomAi-chat-panel",
          "title": "@CHAT",
          "icon": "$(layout)"
        },
        {
          "id": "tomAi-ws-panel",
          "title": "@WS",
          "icon": "$(beaker)"
        }
      ]
    },
    "commands": [
      {
