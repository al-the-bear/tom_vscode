      },
      {
        "command": "tomAi.openInMdBrowser",
        "title": "@T: Open in MD Browser",
        "category": "@Tom",
        "shortTitle": "Open in MD Browser"
      }
    ],
    "views": {
      "tomAi-chat-panel": [
        {
          "type": "webview",
          "id": "tomAi.chatPanel",
          "name": "@CHAT",
          "icon": "$(layout)"
        }
      ],
      "tomAi-ws-panel": [
        {
          "type": "webview",
          "id": "tomAi.wsPanel",
          "name": "@WS",
          "icon": "$(beaker)"
        }
      ],
      "tomAi-sidebar": [
        {
          "type": "webview",
          "id": "tomAi.process",
          "name": "PROCESS",
          "icon": "$(type-hierarchy)"
        },
        {
          "type": "webview",
          "id": "tomAi.questNotes",
          "name": "QUEST NOTES",
          "icon": "$(book)",
          "when": "tomAi.hasWorkspaceFile"
        },
        {
          "type": "webview",
          "id": "tomAi.questTodos",
          "name": "QUEST TODOS",
          "icon": "$(checklist)"
        },
        {
          "type": "webview",
          "id": "tomAi.sessions",
          "name": "SESSIONS",
          "icon": "$(comment-discussion)"
        },
        {
          "type": "webview",
          "id": "tomAi.sessionTodos",
          "name": "SESSION TODOS",
          "icon": "$(clock)"
        }
      ],
      "tomAi-ws-sidebar": [
        {
          "type": "webview",
          "id": "tomAi.vscodeNotes",
          "name": "VS CODE NOTES",
          "icon": "$(note)"
        },
        {
          "type": "webview",
          "id": "tomAi.workspaceNotes",
          "name": "WORKSPACE NOTES",
          "icon": "$(file-text)"
        },
        {
          "type": "webview",
          "id": "tomAi.workspaceTodos",
          "name": "WORKSPACE TODOS",
          "icon": "$(tasklist)"
        },
        {
          "type": "webview",
          "id": "tomAi.todoLogTom",
          "name": "TODO LOG",
          "icon": "$(history)"
        },
        {
          "type": "webview",
          "id": "tomAi.windowStatusTom",
          "name": "WINDOW STATUS",
          "icon": "$(window)"
        }
      ],
      "tomAi-vsc-sidebar": [
        {
          "type": "webview",
          "id": "tomAi.vscResources",
          "name": "RESOURCES",
          "icon": "$(server-process)"
        },
        {
          "type": "webview",
          "id": "tomAi.prerequisites",
          "name": "PREREQUISITES",
          "icon": "$(key)"
        }
      ],
      "tomAi-todo-sidebar": [
        {
          "type": "webview",
          "id": "tomAi.tomTodo",
          "name": "TODO",
          "icon": "$(checklist)"
        }
      ],
      "tomAi-info-sidebar": [
        {
          "type": "webview",
          "id": "tomAi.questNotesPanel",
          "name": "QUEST NOTES",
          "icon": "$(book)"
        },
        {
          "type": "webview",
          "id": "tomAi.runsOverview",
          "name": "RUNS",
          "icon": "$(run-all)"
        },
        {
          "type": "webview",
          "id": "tomAi.userNotifications",
          "name": "USER NOTIFICATIONS",
          "icon": "$(bell-dot)"
        },
        {
          "type": "webview",
          "id": "tomAi.notifications",
          "name": "NOTIFICATIONS",
          "icon": "$(bell)"
        }
      ],
      "explorer": [
        {
          "type": "webview",
          "id": "tomAi.todoLog",
          "name": "TODO LOG",
          "icon": "$(history)"
        },
        {
          "type": "webview",
          "id": "tomAi.windowStatus",
          "name": "WINDOW STATUS",
          "icon": "$(window)"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "tomAi.todoEditor",
        "displayName": "Quest TODO Editor",
        "selector": [
          {
            "filenamePattern": "*.todo.yaml"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "tomAi.trailViewer",
        "displayName": "Trail Viewer",
        "selector": [
          {
            "filenamePattern": "*.prompts.md"
          },
          {
            "filenamePattern": "*.answers.md"
          }
        ],
        "priority": "default"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": "*.prompt-panel.yaml",
        "url": "../../../.tom/json-schema/panels/prompt.schema.json"
      },
      {
        "fileMatch": "*.process.yaml",
        "url": "./out/config/process.schema.json"
      },
      {
        "fileMatch": "prerequisites.yaml",
        "url": "./out/config/prerequisites.schema.json"
      }
    ],
    "keybindings": [
      {
        "command": "-workbench.action.terminal.openNativeConsole",
        "key": "ctrl+shift+c"
      },
      {
        "command": "-workbench.view.extensions",
        "key": "ctrl+shift+x"
      },
      {
        "command": "tomAi.chordMenu.copilot",
        "key": "ctrl+shift+c",
        "when": "!tomAi.chordMenuOpen"
      },
      {
        "command": "tomAi.chordMenu.llm",
        "key": "ctrl+shift+l",
        "when": "!tomAi.chordMenuOpen"
      },
      {
        "command": "tomAi.chordMenu.execute",
        "key": "ctrl+shift+e",
        "when": "!tomAi.chordMenuOpen"
      },
      {
        "command": "tomAi.chordMenu.favorites",
        "key": "ctrl+shift+x",
        "when": "!tomAi.chordMenuOpen"
      },
      {
        "command": "tomAi.layout.maximizeToggle",
        "key": "ctrl+shift+`"
      },
      {
        "command": "tomAi.layout.maximizeToggle",
        "key": "ctrl+shift+1"
      },
      {
        "command": "tomAi.editor.rawTrailViewer",
        "key": "ctrl+shift+5"
      },
      {
        "command": "tomAi.editor.promptQueue",
        "key": "ctrl+shift+6"
      },
      {
        "command": "tomAi.editor.timedRequests",
        "key": "ctrl+shift+7"
      },
      {
        "command": "tomAi.layout.maximizeExplorer",
        "key": "ctrl+shift+2"
      },
      {
        "command": "tomAi.layout.maximizeEditor",
        "key": "ctrl+shift+3"
      },
      {
        "command": "tomAi.layout.maximizeChat",
        "key": "ctrl+shift+4"
      },
      {
        "command": "tomAi.focusChatPanel",
        "key": "ctrl+shift+0"
      },
      {
        "command": "tomAi.layout.windowStateFlow",
        "key": "ctrl+shift+y"
      },
      {
        "command": "tomAi.statusPage",
        "key": "ctrl+shift+8"
      },
      {
        "command": "tomAi.wsPanel.focus",
        "key": "ctrl+shift+9"
      },
      {
        "command": "-workbench.action.newWindow",
        "key": "ctrl+shift+n"
      },
      {
        "command": "tomAi.showSidebarNotes",
        "key": "ctrl+shift+n"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "tomAi.executeFile",
          "when": "resourceExtname == .dart",
          "group": "tomAi@1"
        },
        {
          "command": "tomAi.executeScript",
          "when": "resourceExtname == .dart",
          "group": "tomAi@3"
        },
        {
          "command": "tomAi.openInMdViewer",
          "when": "resourceExtname == .md",
          "group": "tomAi@5"
        },
        {
          "command": "tomAi.openInMdBrowser",
          "when": "resourceExtname == .md",
          "group": "tomAi@6"
        }
      ],
      "editor/context": [
        {
          "command": "tomAi.sendToCopilot.standard",
          "group": "copilot@1"
        },
        {
          "command": "tomAi.sendToCopilot.template",
          "group": "copilot@2"
        },
        {
          "command": "tomAi.sendToCopilot",
          "when": "editorHasSelection",
          "group": "copilot@3"
        },
        {
          "command": "tomAi.sendToLlm.standard",
          "group": "llm@1"
        },
        {
          "command": "tomAi.sendToLlm.template",
          "group": "llm@2"
        },
        {
          "command": "tomAi.sendToLlm",
          "when": "editorHasSelection",
          "group": "llm@3"
        },
        {
          "command": "tomAi.executeFile",
          "when": "editorLangId == dart",
          "group": "tomAi@2"
        },
        {
          "command": "tomAi.executeScript",
          "when": "editorLangId == dart",
          "group": "tomAi@3"
        },
        {
          "command": "tomAi.openInMdViewer",
          "when": "resourceLangId == markdown",
          "group": "tomAi@10"
        },
        {
          "command": "tomAi.openInMdBrowser",
          "when": "resourceLangId == markdown",
          "group": "tomAi@11"
        }
      ],
      "view/title": [
        {
          "command": "tomAi.process.startNested",
          "when": "view == tomAi.process",
          "group": "navigation"
        },
        {
          "command": "tomAi.process.abortNested",
          "when": "view == tomAi.process",
          "group": "navigation"
        },
        {
          "command": "tomAi.sessions.add",
          "when": "view == tomAi.sessions",
          "group": "navigation"
        },
        {
          "command": "tomAi.sessions.removeUnused",
          "when": "view == tomAi.sessions",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Tom AI",
      "properties": {
        "tomAi.configPath": {
          "type": "string",
          "default": "~/.tom/vscode/tom_vscode_extension.json",
          "description": "Path to the extension configuration file, for a layout without a root .tom (supports ~ for home directory, ${workspaceFolder} and ${tomRoot})"
        },
        "tomAi.aiFolder": {
          "type": "string",
          "default": "_ai",
          "deprecationMessage": "Deprecated: use tomAi.layout.aiFolder. Still read as a folder name under the workspace folder; tomAi.layout.aiFolder wins when both are set.",
          "description": "Deprecated alias of tomAi.layout.aiFolder: the AI folder name under the workspace folder (the window's first folder). tomAi.layout.aiFolder wins when both are set."
        },
        "tomAi.layout.root": {
          "type": "string",
          "default": "",
          "description": "Workspace layout override: the root of the Tom workspace, absolute or relative to the workspace folder (the window's first folder). Replaces the walk up to the nearest .tom/tom_root.yaml. Empty: found by the walk up."
        },
        "tomAi.layout.aiFolder": {
          "type": "string",
          "default": "",
          "description": "Workspace layout override: the _ai folder, absolute or relative to the workspace folder. Empty: the workspace folder's _ai when it exists, else the root's (names from .tom/tom_workspace.yaml / .tom/tom_root.yaml defaults)."
        },
        "tomAi.layout.configFolder": {
          "type": "string",
          "default": "",
          "description": "Workspace layout override: the workspace folder's configuration folder, absolute or relative to the workspace folder. Empty: .tom (or the defaults: config of the marker files)."
        },
        "tomAi.layout.guidelinesFolder": {
          "type": "string",
          "default": "",
          "description": "Workspace layout override: the workspace folder's guidelines folder, absolute or relative to the workspace folder. Empty: _agent_guidelines (or the defaults: guidelines of the marker files)."
        },
        "tomAi.queueFolder": {
          "type": "string",
          "default": "",
          "description": "Queue folder path (absolute or workspace-relative). Empty defaults to ${aiFolder}/queue."
        },
        "tomAi.panelStoragePath": {
          "type": "string",
          "default": "",
          "description": "Folder of the panels' local state files (absolute or workspace-relative): the timed requests (<host>_<workspace>.timed.yaml), the chat variables (<workspace>.chatvars.yaml) and the chat panels' drafts (<workspace>.<section>.prompt-panel.yaml). Empty defaults to ${aiFolder}/local."
        },
        "tomAi.bridge.requestTimeout": {
          "type": "number",
          "default": 30000,
          "description": "Bridge request timeout in milliseconds"
        },
        "tomAi.bridge.restartDelay": {
          "type": "number",
          "default": 5000,
          "description": "Delay between bridge restart attempts in milliseconds"
        },
        "tomAi.bridge.maxRestarts": {
          "type": "number",
          "default": 10,
          "description": "Maximum number of bridge restart attempts"
        },
        "tomAi.timedRequests.tickInterval": {
          "type": "number",
          "default": 30000,
          "description": "Timed request engine tick interval in milliseconds"
        },
        "tomAi.todo.workspaceTodoFile": {
          "type": "string",
          "default": "workspace.todo.yaml",
          "description": "Workspace-relative path to the workspace todo YAML file used by WORKSPACE TODOS views"
        },
        "tomAi.notes.questNotesPattern": {
          "type": "string",
          "default": "_ai/quests/${quest}/quest-notes.${quest}.md",
          "description": "Pattern for quest notes file path. Supports ${quest} and ${workspaceFolder}."
        },
        "tomAi.todo.questTodoPattern": {
          "type": "string",
          "default": "todos.${quest}.todo.yaml",
          "description": "Pattern for quest todo filename used by QUEST TODOS view. Supports ${quest}."
        },
        "tomAi.guidelines.excludeGlobs": {
          "type": "array",
          "default": [
            "tom/zom_*/**"
          ],
          "items": {
            "type": "string"
          },
          "description": "Glob patterns excluded when building the non-recursive Project list in the Guidelines panel."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "tom_vscode_extension.json",
        "url": "./out/config/tom_vscode_extension.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node scripts/clean-out.cjs",
    "compile": "node scripts/build-lock.cjs run --command \"npm run compile\" -- npm run compile:steps",
    "compile:steps": "npm run clean && tsc -p ./ && node scripts/copy-config.cjs && node scripts/write-build-info.cjs",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run typecheck:media",
    "test:tools": "node --test --test-concurrency=1 out/tools/__tests__/*.test.js",
    "test:services": "node --test --test-concurrency=1 out/services/__tests__/*.test.js",
    "migrate:ai-formats": "node scripts/migrate-ai-formats.cjs",
    "test:utils": "node --test --test-concurrency=1 out/utils/__tests__/*.test.js",
    "test:managers": "node --test --test-concurrency=1 out/managers/__tests__/*.test.js",
    "test:handlers": "node --test --test-concurrency=1 out/handlers/__tests__/*.test.js",
    "test": "node scripts/run-test-stages.cjs",
    "audit:tools": "node scripts/audit-tool-coverage.cjs",
    "check:todo-yaml": "node scripts/check-todo-yaml.cjs",
    "check:bridges": "node scripts/check-bridge-fresh.cjs",
    "check:bridge-lock": "node scripts/bridge-lock-preflight.cjs --warn",
    "check:tom-bs": "node scripts/check-tom-bs-provenance.cjs",
    "providers:manifest": "node scripts/build-provider-manifest.cjs",
    "providers:check": "node scripts/build-provider-manifest.cjs --check",
    "binaries:report": "node scripts/binaries-layer.cjs report",
    "som:pack": "node scripts/build-som-packages.cjs",
    "check:module-catalogue": "node scripts/check-module-catalogue.cjs",
    "codespecs:build": "node scripts/build-lock.cjs run --command \"npm run codespecs:build\" -- node scripts/build-validate-codespecs.cjs",
    "template:build": "node scripts/build-workspace-template.cjs",
    "codespecs:check": "node scripts/codespecs-binary-stamp.cjs",
    "som:check": "node scripts/check-som-installed.cjs",
    "lint": "eslint src --ext ts",
    "lint:media": "eslint media --ext js --no-error-on-unmatched-pattern",
    "typecheck:media": "tsc -p tsconfig.media.json"
  },
